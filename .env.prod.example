# ORGAMIND — production env template
#
# Copy these into Dokploy's "Environment" tab for the compose application.
# Never commit real values. Replace every placeholder before deploying.

# ── URLs ────────────────────────────────────────────────────────────────────
# APP_BASE_URL: the only public domain (set by Dokploy when you add the
#               domain for the `web` service in the Domains tab).
# CORS_ORIGIN:  same value — frontend and API live on the same origin.
# WEBHOOK_BASE_URL: internal Docker DNS; Evolution calls api directly via
#                   the docker network, no Traefik round-trip. INTERNAL ONLY —
#                   never hand this value to a third-party SaaS.
# PUBLIC_WEBHOOK_BASE_URL: the PUBLIC base an external provider (GoZap) must be
#                   able to reach. Include the proxy prefix: nginx serves the
#                   API under /api (location /api/ -> proxy_pass api:3000/), so
#                   it is `<your domain>/api` — same shape as TWILIO_WEBHOOK_URL.
#                   Leave blank on a deploy with no external session provider.
#                   PROD INCIDENT 2026-08-07: without it, orgamind registered
#                   `http://api:3000/webhooks/gozap` on GoZap, which accepted it
#                   with 200 and could never deliver — the paired number got no
#                   delivery acks, no inbound messages and no opt-out, silently.
# VITE_API_URL: leave commented unless you want to override the bundle's
#               default ("/api"), which nginx proxies to api:3000.
APP_BASE_URL=https://your-app.traefik.me
CORS_ORIGIN=https://your-app.traefik.me
WEBHOOK_BASE_URL=http://api:3000
PUBLIC_WEBHOOK_BASE_URL=https://your-app.traefik.me/api
# VITE_API_URL=/api

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=picoa
POSTGRES_PASSWORD=__CHANGE_ME__strong_random__
POSTGRES_DB=picoa

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# 32+ random bytes, base64-ish. Generate with: openssl rand -base64 48
JWT_SECRET=__CHANGE_ME__paste_openssl_rand_base64_48__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Sal de consentimento ────────────────────────────────────────────────────
# Gere e defina uma única vez no primeiro deploy. Preserve o mesmo valor nos
# deploys seguintes: migrate, api e worker usam este sal para os hashes de
# consentimento. Trocar o valor exige migração explícita dos hashes existentes.
PICOA_CONSENT_SALT=__CHANGE_ME__generate_once_and_never_change__

# ── First-run admin (created idempotently by the migrate job) ───────────────
SEED_ADMIN_EMAIL=admin@picoa.example.com
SEED_ADMIN_PASSWORD=__CHANGE_ME__forced_to_change_on_first_login__

# ── WhatsApp providers ──────────────────────────────────────────────────────
# At least one full credential group below must be set or the app fails to
# boot (see backend/src/shared/config/env.schema.ts). A deploy can run
# several providers/channels at once; there is no single selector var.
EVOLUTION_API_KEY=__CHANGE_ME__strong_random__
EVOLUTION_INSTANCE_NAME=picoa-prod
EVOLUTION_BASE_URL=http://evolution-api:8080   # internal — leave as-is

# ── Optional: Meta Cloud API (all vars required together to enable it) ──────
META_ACCESS_TOKEN=
META_APP_SECRET=
META_BUSINESS_ACCOUNT_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ── Optional: Zernio Cloud API (API_KEY + WEBHOOK_SECRET required together
#    to enable it; BASE_URL defaults to https://zernio.com/api/v1) ──────────
ZERNIO_API_KEY=
ZERNIO_BASE_URL=
ZERNIO_WEBHOOK_SECRET=

# ── Dify ────────────────────────────────────────────────────────────────────
# Dify (auto-resposta conversacional). Inclui o sufixo /v1.
# A chave da OpenAI fica DENTRO do Dify; o orgamind NÃO a guarda.
DIFY_BASE_URL=

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
VITE_SENTRY_DSN=
