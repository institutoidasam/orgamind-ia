{
    # Global options
    email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:picoa.local} {
    encode gzip zstd

    # Backend API
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # WhatsApp webhooks (no /api prefix — Meta config requirement)
    handle /webhooks/* {
        reverse_proxy api:3000
    }

    # Health checks (optional, for external monitoring)
    handle /health/* {
        reverse_proxy api:3000
    }

    # Bull Board admin (optional, behind basic auth on the API)
    handle /admin/queues* {
        reverse_proxy api:3000
    }

    # Frontend (default)
    handle {
        reverse_proxy web:80
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logs to stdout
    log {
        output stdout
        format console
    }
}

# HTTP-only fallback for local development without TLS
:80 {
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3000
    }
    handle /webhooks/* {
        reverse_proxy api:3000
    }
    handle /admin/queues* {
        reverse_proxy api:3000
    }
    handle /health/* {
        reverse_proxy api:3000
    }
    handle {
        reverse_proxy web:80
    }
}
