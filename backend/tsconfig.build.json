{
  "extends": "./tsconfig.json",
  // `rootDir` pinned to `src` so the output is `dist/main.js`, which the Dockerfile
  // CMD, the worker and `validate-consent-salt` rely on. Anything imported from
  // outside `src` (e.g. `test/migrations.ts`) now fails the build instead of
  // silently moving the root up to `backend/` and emitting `dist/src/main.js`.
  "compilerOptions": { "rootDir": "./src" },
  // `scripts` (like `prisma`) holds standalone operational scripts run with tsx,
  // never imported by the app. They use `import.meta.url` for main-module
  // detection, which the CommonJS `nest build` output rejects (TS1470).
  // Test fixtures live next to the specs but import `test/`; production code never imports them.
  "exclude": ["node_modules", "test", "dist", "prisma", "scripts", "**/*spec.ts", "**/*.fixtures.ts", "**/*.test-fixtures.ts", "vitest.config.ts", "vitest.e2e.config.ts"]
}
