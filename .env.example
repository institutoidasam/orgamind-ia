# Database
POSTGRES_USER=picoa
POSTGRES_PASSWORD=picoa
POSTGRES_DB=picoa_dev
DATABASE_URL=postgresql://picoa:picoa@postgres:5432/picoa_dev?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Worker
WORKER_HEALTH_PORT=3001

# Worker tuning (worker process restart required to apply)
WORKER_CONCURRENCY=10
WORKER_RATE_LIMIT_MAX=80
WORKER_RATE_LIMIT_DURATION_MS=1000

# Auth
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp providers — at least one full group below must be set or the app
# fails to boot (see backend/src/shared/config/env.schema.ts). A deploy can
# run several providers/channels at once; there is no single selector var.

# Meta Cloud API (all vars required together to enable this provider)
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me

# Evolution API (optional, dev only)
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=picoa-dev

# Zernio Cloud API (optional — API_KEY + WEBHOOK_SECRET required together to
# enable this provider; BASE_URL defaults to https://zernio.com/api/v1)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=
ZERNIO_WEBHOOK_SECRET=

# ── Identidade da organização titular deste deploy ───────────────────────────
# O orgamind é single-tenant POR INSTALAÇÃO: um deploy por cliente. Estes valores
# vão para o TITULAR DOS DADOS — o texto de consentimento, a landing pública
# /opt-in e o texto do wa.me/QR. A Meta exige que o opt-in NOMEIE o negócio e a
# LGPD exige controlador determinado (art. 8º): um titular que autoriza o nome de
# outra organização não deu um consentimento válido.
#
# Semeiam o singleton `Organization` no PRIMEIRO deploy. Depois disso, a tela de
# Configurações é a fonte da verdade — o seed roda em todo deploy e NÃO
# sobrescreve o que o operador ajustou aqui. Sem estes valores, o fallback é
# neutro ("Organização"), nunca o nome de outro cliente.
#
# ORG_LEGAL_NAME é a razão social por extenso — confira contra o CNPJ: é ela que
# entra DENTRO do texto de consentimento.
ORG_NAME=CONTINUUM
ORG_LEGAL_NAME=Canal do Matheus Garcia - CONTINUUM
# Opcionais. A URL substitui o {url} do texto de consentimento; em branco, aponta
# para a página de privacidade do próprio orgamind.
ORG_PRIVACY_POLICY_URL=
ORG_SUPPORT_CONTACT=

# App
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:3000
# Base PUBLICA do receptor de webhooks — a que um provedor SaaS externo (GoZap)
# precisa alcancar pela internet. Em dev, o tunel (ngrok/cloudflared) vem aqui;
# `localhost` e recusado de proposito (ver shared/config/public-url.ts), porque
# registra-lo num SaaS produz um canal mudo sem nenhum erro.
# PUBLIC_WEBHOOK_BASE_URL=https://SEU-TUNEL.ngrok-free.app
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Bull Board (HTTP basic auth)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-in-production

# TLS (Caddy + Let's Encrypt)
DOMAIN=picoa.example.com
ACME_EMAIL=admin@example.com

# Dify (auto-resposta conversacional). Inclui o sufixo /v1.
# A chave da OpenAI fica DENTRO do Dify; o orgamind NÃO a guarda.
DIFY_BASE_URL=

# Sentry (optional). Leave empty to disable.
SENTRY_DSN=
# Set GIT_SHA at build/deploy time to attach a release identifier to events
# and to enable source map matching, e.g.:
#   GIT_SHA=$(git rev-parse HEAD) docker compose up -d --build
GIT_SHA=
