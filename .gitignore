# Internal docs (scratchpad) — kept outside VCS by preference.
# Exception: docs/superpowers/ holds versioned specs and plans we DO want in git.
# Pattern `docs/*` (not `docs/`) allows whitelisting subdirectories.
docs/*
!docs/superpowers/

# Generated SDKs (regenerable from OpenAPI)
frontend/src/api/generated/

# Local backups
*.bak
*.bkp
*.orig

# Editor temp
*~

# TDD enforcer state (managed by hooks — never commit)
.tdd-paused
.tdd-state
.tdd-state-*
.tdd-cycles
.tdd-cycles-*
.tdd-log.jsonl
.tdd-snapshots/

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.superpowers/

# SSH keys / secrets — never commit
.secrets/

# Dev scratch file (kept locally, must never enter the build: a .ts at the
# backend root changes tsc rootDir and moves dist/main.js to dist/src/main.js)
backend/demo-seed.ts

# worktrees locais dos agentes (nunca versionar)
.worktrees/
